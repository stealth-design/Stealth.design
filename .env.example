# =========================================================================
# CMS / API environment
#
# Copy to `.env` and adjust. `npm run setup` does this for you and generates
# real secrets, which is the safer route: the values below are placeholders
# that the environment loader deliberately refuses to accept in production.
#
# The capture worker has its OWN, much shorter environment — see
# `.env.worker.example`. Do not hand the worker a copy of this file: it holds
# database and storage credentials the worker must never have, and the worker
# refuses to start if it finds any of them (`loadWorkerEnv`).
# =========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
# error | warn | info | debug
UXD_LOG_LEVEL=info
# `json` for production log aggregation, `pretty` for a terminal.
UXD_LOG_FORMAT=pretty

# --- Database ------------------------------------------------------------
# Any Postgres 14+ URL. The default points at the embedded PGlite server
# started by `npm run db:serve`, which speaks the real wire protocol — so the
# driver, the SQL and the migrations are identical to production.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Connection pool ceiling. Ignored for local URLs, which are pinned to one
# connection because PGlite shares a single backend (see client.ts).
DATABASE_POOL_MAX=10
# disable | require | no-verify. Use `require` for a managed provider.
DATABASE_SSL=disable

# --- Sessions ------------------------------------------------------------
# At least 32 characters. Rotating it signs everyone out.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# Session lifetime. 1–720.
SESSION_TTL_HOURS=12
# MUST be `true` anywhere the CMS is not on http://localhost. Production boot
# fails if this is false, because a session cookie sent over plain HTTP is a
# session anyone on the path can take.
SESSION_COOKIE_SECURE=false

# --- Capture worker credential -------------------------------------------
# The bearer token the worker presents to /api/internal/*. At least 32
# characters. This is the ONLY credential the worker gets, and it grants
# nothing but the internal capture endpoints.
WORKER_SHARED_SECRET=replace-me-with-at-least-32-random-characters

# --- Object storage ------------------------------------------------------
# local | s3 | blob. `local` writes files under STORAGE_LOCAL_ROOT and is for
# development only — production boot fails with `local`, because the CMS
# filesystem is not durable storage and screenshots are the expensive artefact.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/media
# Vercel Blob (STORAGE_DRIVER=blob): connect a Blob store to the CMS project
# in Vercel and it sets BLOB_READ_WRITE_TOKEN for you. Files are served
# through the CMS's own routes, so a private store works and stays private.
# BLOB_READ_WRITE_TOKEN=
# STORAGE_BLOB_ACCESS=private

# S3 or any S3-compatible service (R2, MinIO, B2). Required when
# STORAGE_DRIVER=s3.
# STORAGE_S3_BUCKET=uxd-media
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Needed by MinIO and some self-hosted gateways.
# STORAGE_S3_FORCE_PATH_STYLE=false
# A CDN domain, if the bucket is publicly readable. When unset, media is served
# through the CMS's own session-gated /media route.
# STORAGE_PUBLIC_BASE_URL=https://media.example.com

# --- Origins -------------------------------------------------------------
# Where the CMS is served from. Used for absolute links and cookie scoping.
CMS_BASE_URL=http://localhost:3000
# The public site's origin, allowed to call the public API cross-origin.
PUBLIC_FRONTEND_ORIGIN=http://localhost:3001

# --- Public site ---------------------------------------------------------
# The only variable the public site reads. It has no database access and no
# other data source, so this is the whole of its configuration.
#
# It also determines the origin the site's own CSP allows images from, since
# screenshots are served by the CMS rather than by the site itself.
PUBLIC_API_BASE_URL=http://localhost:3000/api/public

# --- Classification ------------------------------------------------------
# none      — no suggestions at all
# heuristic — structural signals only, offline, no API key, confidence capped
#             below the auto-apply floor so nothing is ever applied unattended
# anthropic — heuristic plus a model, requires ANTHROPIC_API_KEY
#
# Classification is never required for the pipeline to work. Capture, review
# and publishing all function with CLASSIFICATION_PROVIDER=none.
CLASSIFICATION_PROVIDER=heuristic
# ANTHROPIC_API_KEY=sk-ant-...
CLASSIFICATION_MODEL=claude-opus-5

# --- Uploads -------------------------------------------------------------
# Cap on one uploaded file, in megabytes. 1–2048.
MEDIA_MAX_UPLOAD_MB=64
