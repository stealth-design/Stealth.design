# =========================================================================
# Capture worker environment
#
# Copy to `.env.worker`.
#
# ## Read this before adding a variable
#
# This file is deliberately short, and its shortness is a security control
# rather than an oversight. The worker runs Playwright against arbitrary
# websites, so it is treated as hostile-input infrastructure: it holds no
# database credential, no object-storage credential, no session secret and no
# API key. Everything it needs, it asks the CMS for over HTTP, authenticated
# with the single token below.
#
# `loadWorkerEnv` enforces this at startup: if DATABASE_URL, SESSION_SECRET,
# any STORAGE_* variable or ANTHROPIC_API_KEY is present in the worker's
# environment *at all*, the worker refuses to boot. Handing it a copied `.env`
# is a crash, not a silent expansion of what a compromised browser could
# reach. `scripts/check-boundaries.mjs` enforces the same thing at build time
# by failing if the worker gains an import of the database, auth or storage
# packages.
#
# So: do not paste the CMS's `.env` here, and do not add a database URL to
# "make something easier". If the worker needs a fact from the database, the
# right change is an endpoint under /api/internal/*.
# =========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
UXD_LOG_LEVEL=info
UXD_LOG_FORMAT=pretty

# --- Control plane -------------------------------------------------------
# The only host the worker may call besides the sites it is told to capture.
CONTROL_PLANE_URL=http://localhost:3000
# Must match the CMS's WORKER_SHARED_SECRET, or be a token minted in the CMS.
# At least 32 characters.
WORKER_TOKEN=replace-me-with-at-least-32-random-characters
# Stable identity for this instance in logs, the CMS worker list and the
# provenance recorded on every capture.
WORKER_NAME=worker-local

# --- Throughput ----------------------------------------------------------
# Concurrent browser contexts. Each costs roughly 150-350MB, so this is the
# variable to tune against the container's memory limit rather than the CPU.
WORKER_CONCURRENCY=2
# Items leased per poll.
WORKER_BATCH_SIZE=4
# Idle poll interval, ms. 250–60000.
WORKER_POLL_INTERVAL_MS=1500
# Lease duration, seconds. A crashed worker's items become re-leasable after
# this, so it is the upper bound on how long work sits stuck after a crash —
# not a per-page timeout, which is WORKER_ITEM_TIMEOUT_MS below.
WORKER_LEASE_SECONDS=300

# --- Hard ceilings -------------------------------------------------------
# Per-job configuration may lower these but never raise them. They are the
# last line of defence against a page that is hostile rather than merely large.
# Total bytes a single page may pull, including subresources.
WORKER_MAX_PAGE_BYTES=15728640
# Bytes any one HTTP response may return. Enforced while reading, so an
# unbounded or lying Content-Length cannot exhaust memory.
WORKER_MAX_RESPONSE_BYTES=26214400
# Navigation timeout, ms.
WORKER_NAV_TIMEOUT_MS=30000
# Whole-item deadline, ms. Includes navigation, scrolling, screenshots and
# uploads, so a page that loads fast and then spins cannot hold a lease.
WORKER_ITEM_TIMEOUT_MS=120000
# Redirect hops. Every hop is re-checked against the SSRF guard, so this bounds
# the work rather than the safety.
WORKER_MAX_REDIRECTS=5
# Advisory locally; enforced by the container in production.
WORKER_MEMORY_LIMIT_MB=2048

# --- Filesystem ----------------------------------------------------------
# Scratch directory for Playwright and Crawlee. Must be disposable: it is
# wiped between items, and nothing durable belongs here.
CRAWLEE_STORAGE_DIR=./storage

# --- Identification ------------------------------------------------------
# Set a contact URL. A site owner who notices the traffic should be able to
# find out who we are and ask us to stop, and the default user agent includes
# whatever is set here.
# WORKER_CONTACT_URL=https://example.com/research
# Override the full user agent only if you have a reason to. Do not
# impersonate a browser you are not, and do not remove the research
# identification.
# WORKER_USER_AGENT=
