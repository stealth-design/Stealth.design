{
  "name": "@uxd/ingestion-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo storage",
    "dev": "npm run build && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "postinstall:browsers": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@uxd/crawler": "0.1.0",
    "@uxd/shared": "0.1.0",
    "@uxd/types": "0.1.0",
    "playwright": "1.64.1",
    "undici": "8.10.1",
    "zod": "4.5.4"
  }
}
